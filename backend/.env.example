# SECRETS (Required)
GROQ_API_KEY=your_groq_api_key_here
REDIS_URL=your_upstash_redis_url_here

# ModelScope (Primary LLM provider - OpenAI-compatible endpoint)
# When MODELSCOPE_API_KEY is set, ModelScope answers first and Ollama/Groq become fallbacks.
# Leave it unset to fall back to the previous Ollama -> Groq behaviour.
MODELSCOPE_API_KEY=your_modelscope_api_key_here
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
MODELSCOPE_MODEL=Qwen/Qwen3.8-Flash-Next

# Qdrant Cloud (Required - get free cluster at cloud.qdrant.io)
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Note: All other settings have defaults in config.py
